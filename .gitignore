# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins*
app/build/
app/.packages
app/pubspec.lock
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/**/*.iml

# Inter IS committed (Google Fonts variable file, SIL OFL 1.1). The previous
# fetch-at-build-time policy pointed at a URL that now 403s, so it could never
# have worked. Do not re-add an ignore rule here — it silently drops the font
# from commits and the failure only surfaces as a missing asset in CI.

# Generated brand rasters (SVGs are the source; PNGs are previews)
brand/*.png

# OS / editor
.DS_Store
.idea/
.vscode/
node_modules/

# Copied from brand/ by app/tool/bootstrap.sh — brand/ is the source of truth.
app/assets/brand/
