<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Vector 1 — QR. Camera only, no storage: SWIP never reads the photo library
      unless the user explicitly picks an image, which goes through the system
      photo picker and needs no permission.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Vector 2 — NFC / HCE. -->
    <uses-permission android:name="android.permission.NFC" />

    <!--
      `F-131` - the floating scan bubble.

      SYSTEM_ALERT_WINDOW is a SPECIAL permission: declaring it here grants
      nothing. The user has to flip a switch in Android Settings, and SWIP asks
      only after explaining, from one screen whose only job is to explain -
      see `bubble_settings.dart`. The bubble is OFF until they do.

      FOREGROUND_SERVICE keeps the bubble alive; Android 14 additionally
      requires a declared type, and `specialUse` is the honest one - this is
      not media playback, location or a data sync pretending otherwise.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      `F-159` — the bubble survives a reboot and an app update.

      Allowed for this service specifically: Android 15 blocks a
      BOOT_COMPLETED receiver from starting dataSync, camera, mediaPlayback,
      phoneCall, mediaProjection and microphone foreground services, and
      **specialUse is not on that list**. See SwipBootReceiver for the citation.

      NOT accompanied by REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, and that is
      deliberate. Google Play prohibits asking for a direct Doze exemption
      "unless the core function of the app is adversely affected", and the
      acceptable-use list is messaging, enterprise VOIP, safety, task
      automation and peripheral-companion apps. A floating shortcut button is
      none of those. The foreground service is already Doze-exempt while it
      runs, which is the sanctioned mechanism; anything beyond that is the
      user's own trip to their OEM's battery settings, and the wizard walks
      them there rather than SWIP asking for a permission it cannot defend.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 13+. Without it the ongoing notice the foreground service is
      required to post is silently suppressed. The service still runs and the
      bubble still appears — but the user loses the "Turn off" action and any
      sign of why SWIP is in their shade, which is the opposite of the
      transparency an overlay app owes them.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false" />

    <!--
      INTERNET — **the justification written here was Vector 3, link
      resolution, and that feature was deleted in `F-89`.** The comment
      outlived the reason, which is exactly how an app ends up shipping a
      permission nobody can explain to a reviewer.

      What might still need it, neither verified on a device:

        * **Flutter's debug tooling.** `flutter create` puts INTERNET in the
          debug and profile manifests, not the main one, because the VM service
          needs it. This project has only a main manifest, so debug builds are
          relying on it from here.
        * **`geocoding`.** Android's `Geocoder` is a system service and the
          system makes the request, so the app may not need INTERNET at all -
          but reports differ by OEM, and getting it wrong silently kills the
          "Dombivli East, Kalyan" labels on captures.

      The fix is the standard Flutter split: INTERNET in `src/debug/` and
      `src/profile/` only, so the release build does not ship it. **That has to
      be checked on a real device before release** - guessing here either
      breaks the debug APK or breaks reverse-geocoding, and both would be found
      by a user rather than by CI. Tracked as 4.1 in
      docs/30-PRE-LAUNCH-PARAMETERS.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      F-40 — where a capture happened.

      COARSE only, and requested at the moment the user turns the feature on in
      Settings rather than at install. It is off by default: SWIP works
      completely without it, and a location prompt on first run from an app that
      has not yet shown you anything useful is how permissions get denied
      permanently.

      The fix is reduced to a 6-character geohash (~1.2 km) before storage, so
      the ledger — which the user exports to their own Drive — never contains
      the coordinates of their front door.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      DELIBERATELY ABSENT, and this is a design decision, not an oversight:

        READ_SMS / RECEIVE_SMS — Google Play restricts these to default SMS
        handlers. Financial apps that auto-import bank transaction SMS have been
        explicitly rejected under this policy. And it would not even pay off:
        bank SMS carries a narration, not an MCC. SWIP asks the user instead
        (S-13). See docs/03-RESEARCH §8.

        ACCESS_FINE_LOCATION — a geohash at this precision is satisfied by
        coarse location. Fine location would buy nothing and cost trust.

        ACCESS_BACKGROUND_LOCATION — SWIP only ever asks where you are at the
        instant you capture something, while you are looking at the screen.
    -->

    <application
        android:label="SWIP"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Vector 7 — the pay-by-app intent.

              NPCI requires merchants to offer "Pay by any UPI App" on Android,
              which fires an IMPLICIT intent. Android shows every app that can
              handle it, and that list is the bottom sheet you see at checkout.
              The intent carries `mc` — the merchant category code — before any
              money moves.

              SWIP registers here to READ that field and then hand the identical
              intent straight on to a real UPI app. It renders no payment UI,
              holds no funds, and is not a PSP. See docs/18-INTENT-CAPTURE.
            -->
            <intent-filter android:label="@string/swip_intent_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>

            <!--
              Share-to-SWIP — `S-24`, and the answer to `F-41`.

              Checkout apps that build their UPI list from an allowlist will
              never show SWIP however it registers (docs/20-FEEDBACK-ROUND-2).
              But every one of those screens has a copy or share action, and the
              share sheet is a list nobody curates. One extra tap, works
              everywhere, no permission.

                text/plain — a payment link or a upi:// string
                image/*    — a screenshot of a payment screen; SWIP reads the
                             QR out of the picture
            -->
            <intent-filter android:label="@string/swip_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/swip_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Vector 2 — the HCE service.

          BIND_NFC_SERVICE is enforced by the platform: only the NFC system
          service may bind here.
        -->
        <service
            android:name=".SwipListenService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <!--
          `F-163` — the hovering scanner.

          `exported="false"`: only SWIP's own bubble may open it. An exported
          transparent Activity that switches on the camera is something any
          app on the device could launch.

          `singleInstance` + `excludeFromRecents` put it in its own task.
          Without that it joins MainActivity's, so closing the card can
          surface the whole app — the user taps the bubble over their bank,
          dismisses the scanner, and lands in SWIP instead of back where they
          were.

          `configChanges` covers rotation and the rest for the same reason
          MainActivity does: Flutter handles these itself, and letting Android
          recreate the Activity would restart the engine and the camera
          mid-scan.

          The theme is what makes it translucent, and it must be set here —
          Android decides translucency when the window is created and it
          cannot be switched on from code afterwards. See
          res/values/swip_hover_styles.xml.
        -->
        <activity
            android:name=".SwipHoverActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity="in.swip.app.hover"
            android:theme="@style/SwipHoverTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
          `F-159` — brings the bubble back after a reboot or an app update.

          `exported="true"` is required for BOOT_COMPLETED, which is a system
          broadcast: the OS is the sender, and a receiver the OS cannot reach
          never fires. The intent filter is the whole attack surface and it
          carries only protected system actions, which no other app is
          permitted to send.
        -->
        <receiver
            android:name=".SwipBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          `F-158` — the floating bubble.

          **This element is the reason the feature was dead.** `F-131` shipped
          the permission screen and the toggle; there was no service to
          register, so the switch wrote a boolean and nothing drew anything.

          `exported="false"` is not boilerplate here: nothing outside SWIP has
          any business starting a window that draws over other apps, and an
          exported overlay service is a tapjacking primitive handed to every
          other app on the device.

          `foregroundServiceType="specialUse"` is required from Android 14.
          The nested property is the justification a Play reviewer reads, and
          it is the honest one — this is not media playback, location or a
          data sync wearing a costume. It is a button that floats.
        -->
        <service
            android:name=".SwipBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A floating button the user switched on, which opens SWIP's merchant-category scanner over whatever app they are in. It draws a 48dp circle and nothing else, reads no other app's content, and uses no accessibility service." />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          `F-115` - the Quick Settings tile.

          Kept alongside the floating bubble (`F-131`), not replaced by it.
          The tile needs no permission at all, because the user adds it
          themselves - so it stays the route for anyone who does not want to
          grant SYSTEM_ALERT_WINDOW, and it is the only route on a work profile
          where the overlay permission is often blocked by policy.
        -->
        <service
            android:name=".SwipTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="Scan a shop code"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Offers the tile to the user on first launch (Android 13+)
                 instead of making them hunt for it in the edit panel. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
