<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SWIP</string>

    <!--
      Shown in Android's "Tap &amp; pay" settings screen, where SWIP appears
      alongside real wallets. The wording is deliberate: a user comparing this
      list must be able to tell at a glance that SWIP does not pay for anything.
    -->
    <string name="swip_hce_description">SWIP reads a terminal\'s merchant category and stops. It cannot make a payment.</string>

    <string name="swip_hce_aid_group">Merchant category reader — no payment is made</string>

    <!--
      Shown as SWIP's name inside the merchant's "pay by app" sheet, beside
      GPay and PhonePe. It must not read like a wallet: a user glancing at that
      list has to understand this one does not pay.
    -->
    <string name="swip_intent_label">SWIP · read category</string>

    <!--
      Shown in Android's share sheet. This is the row a person hunts for after
      hitting "share" on a checkout screen, so it says what will happen rather
      than just naming the app.
    -->
    <string name="swip_share_label">SWIP · check the category</string>

    <!--
      `F-158` — the floating bubble.

      Every string here is read either off a lock-screen-adjacent notification
      or by a screen reader describing a circle with no text in it, so each one
      says what SWIP will DO rather than naming a feature.
    -->

    <!-- The pill's one word, shown for a moment when the bubble is tapped. -->
    <!--
      `F-185`. **No longer used on a tap.** It said "Scanning…" the moment the
      bubble was pressed, which was two things wrong at once: nothing was
      scanning yet — the hovering window had not even started its engine — and
      expanding into a pill to say so is what turned the circle into a rounded
      rectangle the owner reported. A tap now opens the fan instead.

      Kept because [peek] is still the right animation for a message the bubble
      genuinely has, and deleting the string would leave the method with no
      default.
    -->
    <string name="swip_bubble_peek">Reading…</string>

    <!-- `F-185`. The fan. -->
    <string name="swip_fan_qr">Scan a code</string>
    <string name="swip_fan_pos">Tap a card machine</string>
    <string name="swip_fan_close">Close</string>

    <!--
      TalkBack reads this. The bubble is a 56 dp circle containing a glyph and
      no text, so without it a blind user is told "button" and nothing more.
    -->
    <string name="swip_bubble_description">SWIP scan button. Double tap to read a shop code. Drag to move it, or drag it onto the moon to snooze it for ten minutes.</string>

    <string name="swip_bubble_channel">Floating scan button</string>
    <string name="swip_bubble_channel_note">Android requires an ongoing notification while an app draws over other apps. This is it. It never makes a sound.</string>

    <string name="swip_bubble_running">SWIP is one tap away</string>
    <string name="swip_bubble_running_note">Tap the floating button to read a shop\'s code.</string>
    <string name="swip_bubble_turn_off">Turn off</string>

    <!--
      `F-167` — snooze. Two ways in, because a long-press is faster and a
      labelled button is the only way anyone finds out the long-press exists.
    -->
    <string name="swip_bubble_snooze_hour">Snooze 1 hour</string>
    <!--
      `F-173`. What the bubble says as it goes, and it says it as a system
      toast rather than in the bubble, because the bubble is the thing that
      just left. The shape is taken from the owner's Wispr Flow screenshot:
      how long, and how to end it early, in one line.

      "Shake your phone" is stated because nobody guesses a shake gesture. An
      undiscoverable way back is the same as no way back, and the previous
      snooze had exactly that problem — it lasted until tomorrow and the only
      escape was to open SWIP and find a switch.
    -->
    <string name="swip_bubble_snoozed_toast">SWIP is snoozed for 10 minutes. Shake your phone to bring it back.</string>

    <!-- Spoken by TalkBack when the drag target appears. -->
    <string name="swip_bubble_snooze_target">Drop here to snooze SWIP for ten minutes</string>
</resources>
